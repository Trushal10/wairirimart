APP_NAME=Laravel
# Ship production-safe defaults. Override APP_ENV=local and APP_DEBUG=true
# ONLY in a local .env — never in production.
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=business_card
DB_USERNAME=root
DB_PASSWORD=

# Absolute path to the mysqldump binary. Required on Windows/XAMPP because
# mysqldump.exe is not usually on PATH. On Linux/prod, leave this unset and
# `mysqldump` will resolve from PATH.
# MYSQLDUMP_PATH="D:/xampp8.2/mysql/bin/mysqldump.exe"

# Show the "Sign in with phone (OTP)" tab on the customer login page.
# Backend endpoints stay wired regardless; this flag only controls the UI.
# Flip to true once Msg91/Twilio/Fast2SMS credentials are configured.
PHONE_OTP_LOGIN_ENABLED=false

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Set to true in production when serving over HTTPS.
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Google reCAPTCHA v3 — used on the storefront contact form. Leave blank in
# dev and the captcha check is skipped (the honeypot field still runs).
# Get keys at https://www.google.com/recaptcha/admin/create (choose v3).
# V3_RECAPTCHA_SITE_KEY=
# V3_RECAPTCHA_SECRET_KEY=
# V3_RECAPTCHA_THRESHOLD=0.5

# Order and shipping SMS. Set "none" to switch texting off entirely — nothing
# is sent and nothing is logged, and customers still get their order emails.
# The default is "log", which only writes the message to laravel.log; that is
# fine in dev, but a production site left on it delivers nothing while every
# send still reports success, so it warns.
SMS_DRIVER=none           # none | log | msg91 | fast2sms | twilio
# msg91 (India, DLT). All three are required: without MSG91_SENDER the
# messages go out with no DLT-registered header and get rejected.
# MSG91_AUTH_KEY=
# MSG91_TEMPLATE_ID=
# MSG91_SENDER=
# FAST2SMS_API_KEY=
# TWILIO_SID=
# TWILIO_TOKEN=
# TWILIO_FROM=

# Customer-facing order tracking. false hides every tracking link and
# disables the /track routes.
ORDER_TRACKING_ENABLED=true
